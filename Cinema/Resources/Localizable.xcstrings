      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ د"
          }
        }
      }
    },
    "%@ used · %@ free": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مستخدم %@ · متاح %@"
          }
        }
