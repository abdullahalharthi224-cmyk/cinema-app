    "1080p": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "1080p"
          }
        }
      }
    },
    "4K": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "4K"
          }
        }
      }
    },
    "720p & Lower": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "720p وأقل"
          }
        }
      }
    },
    "A backup keeps your profiles, library and addons safe if you ever reinstall Cinema.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النسخة الاحتياطية تحفظ ملفاتك الشخصية ومكتبتك وإضافاتك إذا أعدت تثبيت Cinema."
          }
        }
      }
    },
    "A good 1080p file at a sensible size. 4K files can be several times larger.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملف 1080p جيد بحجم معقول. ملفات 4K قد تكون أكبر بعدة أضعاف."
          }
        }
      }
    },
    "API Read Access Token": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "API Read Access Token"
          }
        }
      }
    },
