    "Couldn't reach Stremio. Check your internet connection and try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الوصول إلى Stremio. تحقّق من اتصالك بالإنترنت وحاول مرة أخرى."
          }
