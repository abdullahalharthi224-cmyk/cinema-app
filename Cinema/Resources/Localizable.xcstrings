    "Addons": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإضافات"
          }
        }
      }
    },
    "Addons are where all content comes from. Cinema doesn't host or provide any content itself.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل المحتوى يأتي من الإضافات. تطبيق Cinema لا يستضيف أي محتوى ولا يوفّره بنفسه."
          }
        }
      }
    },
    "Adjust": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضبط"
          }
        }
      }
    },
    "Age Rating": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التصنيف العمري"
          }
        }
      }
