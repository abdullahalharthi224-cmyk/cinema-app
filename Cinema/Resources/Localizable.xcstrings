    "Sign in at mdblist.com, open Preferences, and copy your API key. It's stored only in this iPhone's Keychain.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل الدخول في ⁨mdblist.com⁩ وافتح «⁨Preferences⁩» وانسخ مفتاح ⁨API⁩. يُحفظ فقط في سلسلة مفاتيح هذا الآيفون."
          }
        }
      }
    },
    "Sign in at themoviedb.org, open Settings → API, and copy the “API Read Access Token” (the long one). It's stored only in this iPhone's Keychain.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل الدخول في ⁨themoviedb.org⁩، وافتح «⁨Settings⁩» ثم «⁨API⁩»، وانسخ «⁨API Read Access Token⁩» (المفتاح الطويل). يُحفظ فقط في سلسلة مفاتيح هذا الآيفون."
          }
        }
      }
    },
