          "stringUnit": {
            "state": "translated",
            "value": "يفحص ملف الإضافة وزمن استجابتها، ويجرّب جلب روابط فيلم The Shawshank Redemption."
          }
        }
      }
    },
    "That doesn't look like a valid addon link.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا لا يبدو رابط إضافة صحيحاً."
          }
