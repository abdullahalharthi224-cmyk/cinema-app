    "%lld desktop-only addons were skipped because they can't work on iPhone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تخطي %lld من إضافات الكمبيوتر لأنها لا تعمل على iPhone."
          }
        }
      }
    },
    "%lld languages": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld لغات"
          }
        }
      }
    },
    "%lld min": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld دقيقة"
          }
        }
      }
    },
