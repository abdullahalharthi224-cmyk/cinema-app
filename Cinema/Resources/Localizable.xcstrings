    "Add Profile": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إضافة ملف"
          }
        }
      }
    },
    "Add by Link": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إضافة عبر رابط"
          }
        }
      }
    },
    "Add it from the Home Screen: touch and hold, tap Edit → Add Widget, then choose Cinema.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضفه من الشاشة الرئيسية: اضغط مطولًا، ثم «تعديل» ← «إضافة أداة»، واختر ⁨Cinema⁩."
          }
        }
      }
    },
    "Add titles to My List with the + button, and the ones you start watching will appear here too.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف أعمالاً إلى قائمتي بزر +، وستظهر هنا أيضاً الأعمال التي تبدأ بمشاهدتها."
          }
        }
      }
    },
    "Add to List": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف إلى قائمة"
          }
        }
      }
    },
    "Add to My List": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إضافة إلى قائمتي"
          }
        }
      }
    },
    "Add your TMDB key": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف مفتاح ⁨TMDB⁩"
          }
        }
      }
    },
    "Add your TMDB key in Settings first.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف مفتاح ⁨TMDB⁩ من الإعدادات أولاً."
