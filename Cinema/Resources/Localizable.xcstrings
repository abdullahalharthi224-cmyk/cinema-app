      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف مفتاح TMDB"
          }
        }
      }
    },
    "Add your TMDB key in Settings first.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف مفتاح TMDB من الإعدادات أولاً."
          }
        }
      }
    },
    "Added by link": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُضيفت عبر رابط"
          }
