    },
    "Unlocks Netflix, Apple TV+, Shahid and more.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لعرض Netflix وApple TV+ وشاهد وغيرها."
          }
        }
      }
    },
    "Up to %lld profiles. Each has its own Continue Watching and Library.": {
      "localizations": {
        "ar": {
          "stringUnit": {
