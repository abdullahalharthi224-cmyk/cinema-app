    "AirPlay": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay"
          }
        }
      }
    },
    "AirPlay sends the sound only for this format. Use Screen Mirroring for the picture.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مع هذا النوع من الملفات يرسل AirPlay الصوت فقط. استخدم «انعكاس الشاشة» لعرض الصورة."
          }
        }
      }
    },
