    "Welcome to Cinema": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرحباً بك في Cinema"
          }
        }
      }
    },
    "Who's Watching?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من يشاهد؟"
          }
        }
      }
